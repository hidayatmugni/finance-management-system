rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Break-glass owners. Mirrors `ownerEmails` in src/shared/firebase/config.js
     * — the client decides what role to write, these rules decide what is
     * actually allowed, so the two lists must stay in step.
     *
     * These accounts keep full access even if their member record is missing,
     * corrupted, or demoted, which is what makes the workspace recoverable.
     */
    function superAdminEmails() {
      return ['mugnihidayat023@gmail.com'];
    }

    function isSuperAdmin() {
      // The null check matters: calling .lower() on a missing email aborts rule
      // evaluation entirely, which would deny even legitimate requests.
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in superAdminEmails();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function hasFamilyProfile(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId;
    }

    function canAccessFamily(familyId) {
      return isFamilyMember(familyId) || hasFamilyProfile(familyId) || isSuperAdmin();
    }

    function memberRole(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role;
    }

    function isFamilyOwner(familyId) {
      return isFamilyMember(familyId) && memberRole(familyId) == 'owner';
    }

    function isFamilyAdmin(familyId) {
      // Break-glass owners count as admins everywhere, including the CMS, so a
      // broken member record can always be repaired from inside the app.
      return isSuperAdmin() ||
        (isFamilyMember(familyId) && memberRole(familyId) in ['owner', 'admin']);
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isSuperAdmin();
      allow create, delete: if isSelf(userId) || isSuperAdmin();

      /*
       * Users may maintain their own profile but NOT their own role — the
       * previous version allowed any signed-in account to rewrite anybody's
       * role, which let a member promote themselves to owner. Role changes now
       * come only from a family admin (the Members page) or a break-glass owner.
       */
      allow update: if isSuperAdmin()
        || (isSelf(userId) && request.resource.data.role == resource.data.role)
        || isFamilyAdmin(resource.data.familyId);
    }

    match /families/{familyId} {
      // Any signed-in user may read the family document so the very first login
      // can bootstrap itself before a member record exists.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isFamilyAdmin(familyId);

      match /members/{memberId} {
        allow read: if canAccessFamily(familyId) || isSelf(memberId);

        // A new sign-in provisions its own member record.
        allow create: if isSelf(memberId) || isFamilyAdmin(familyId) || isSuperAdmin();

        // Own profile: yes. Own role: no — otherwise any member could promote
        // themselves. Promotion goes through an admin or a break-glass owner.
        allow update: if isFamilyAdmin(familyId)
          || isSuperAdmin()
          || (isSelf(memberId) && request.resource.data.role == resource.data.role);

        allow delete: if isFamilyOwner(familyId) || isSuperAdmin();
      }

      /* ---- Day-to-day data: any member of the family reads and writes. ---- */

      match /transactions/{documentId} {
        allow read, write: if canAccessFamily(familyId);
      }

      match /categories/{documentId} {
        allow read, write: if canAccessFamily(familyId);
      }

      match /accounts/{documentId} {
        allow read, write: if canAccessFamily(familyId);
      }

      // Budgets previously had no rule at all, so every save failed with
      // permission-denied. They follow the same access as other household data.
      match /budgets/{documentId} {
        allow read, write: if canAccessFamily(familyId);
      }

      match /savingGoals/{documentId} {
        allow read, write: if canAccessFamily(familyId);
      }

      match /savingContributions/{documentId} {
        allow read, write: if canAccessFamily(familyId);
      }

      match /financeRecords/{documentId} {
        allow read, write: if canAccessFamily(familyId);
      }

      match /financePayments/{documentId} {
        allow read, write: if canAccessFamily(familyId);
      }

      /* ---- CMS: everyone reads it (the UI is built from it), admins write. ---- */

      match /appConfig/{section} {
        allow read: if canAccessFamily(familyId);
        allow write: if isFamilyAdmin(familyId);
      }

      match /syncLogs/{logId} {
        allow read: if isFamilyAdmin(familyId);
        allow write: if false;
      }
    }
  }
}
